////
//// Central PC: Zenoh router + ros2dds for one robot domain (fleet).
//// Placeholders: __ROBOT__, __DOMAIN__
////
//// Robot->central map/tf: subscribers ONLY (no publishers for those),
//// so central does not echo topics back to the robot over Zenoh.
//// Actions stay bidirectional.
////
{
  mode: "router",
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },
  scouting: {
    multicast: { enabled: false },
  },
  plugins: {
    ros2dds: {
      domain: __DOMAIN__,
      ros_localhost_only: true,
      nodename: "zenoh_bridge_central___ROBOT__",
      reliable_routes_blocking: false,
      allow: {
        publishers: [
          "/__ROBOT__/safe_node",
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        subscribers: [
          "/__ROBOT__/map",
          "/__ROBOT__/map_wire_z",
          "/__ROBOT__/tf_zenoh",
          "/__ROBOT__/tf_static_zenoh",
          "/__ROBOT__/nav2_collision_ahead",
          "/__ROBOT__/nav2_retrace_active",
          "/__ROBOT__/wifi_quality",
          "/__ROBOT__/link_retreat_active",
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_servers: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_clients: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        action_servers: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
        action_clients: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
      },
      pub_max_frequencies: [
        "/__ROBOT__/map=1",
        "/__ROBOT__/map_wire_z=1",
        "/__ROBOT__/tf_zenoh=10",
        "/__ROBOT__/tf_static_zenoh=1",
      ],
    },
  },
}
